POSTGRES_DB=zaccounting
POSTGRES_USER=zaccounting
POSTGRES_PASSWORD=replace-with-a-local-development-password

WEB_PORT=3202
API_PORT=8202
DB_PORT=25434

DB_URL=jdbc:postgresql://localhost:25434/zaccounting
DB_USERNAME=zaccounting
DB_PASSWORD=replace-with-a-local-development-password

# Generate a random secret of at least 32 characters. Keep this same key across API replicas.
AUTH_RATE_LIMIT_PEPPER=

# Generate with: openssl rand -base64 32. Required before the API starts.
AUTH_OUTBOX_ENCRYPTION_KEY=
AUTH_COOKIE_SECURE=false
PUBLIC_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Comma-separated CIDRs for reverse proxies allowed to supply X-Forwarded-For.
TRUSTED_PROXY_CIDRS=
AUTH_MAIL_POLL_INTERVAL=2000

# Configure SMTP before enabling account registration or recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
